#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export SANDBOX_HOME_BIND="${SANDBOX_HOME_BIND:-$REPO_ROOT/.sandbox-home}"
export SANDBOX_WORKSPACE_BIND="${SANDBOX_WORKSPACE_BIND:-$REPO_ROOT}"

exec "$REPO_ROOT/bin/sandbox" prek "$@"
